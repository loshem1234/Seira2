# Sanctum — the Seira web layer, running atop the real Hermes agent.
# Deterministic build for Railway: point the service's "Dockerfile Path"
# setting at this file so Railway's monorepo auto-detection is bypassed.
#
# HISTORY: earlier builds of this file (comment used to read "Phase W1
# — without the Hermes runtime") shipped only seira_core/seira_bridge/
# seira_web, talking to Anthropic directly. That was scaffolding for an
# earlier phase, not the intended end state — she is meant to operate
# atop Hermes, in all (see docs/seira/DECISIONS.md D126, D133). This
# COPY list is the real, minimal set: every path below was verified by
# actually importing run_agent.py / agent.conversation_loop /
# agent.agent_init / seira_web.hermes_session from an isolated copy
# containing ONLY these paths, in a venv with ONLY
# requirements-hermes.txt installed — not assumed from reading source.
# See docs/seira/WIRING.md Part 8 for the exact verification steps, so
# a future maintainer can re-verify rather than re-guess.
#
# Deliberately NOT copied, because they are not needed to import or run
# a per-turn AIAgent call and would only add weight: gateway/ (TUI/
# chat-platform machinery — Discord, Slack, Matrix, etc. — Sanctum is
# not a chat-platform gateway), the Node/Playwright/custom-SQLite build
# stages from the main Dockerfile (browser automation and the TUI
# aren't reachable from a stateless web API call), hermes_state_common
# (in-flight async-delegation restoration across restarts — moot when
# a fresh AIAgent is constructed every turn anyway).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY seira_web/requirements.txt seira_web/requirements.txt
COPY seira_web/requirements-hermes.txt seira_web/requirements-hermes.txt
RUN pip install --no-cache-dir -r seira_web/requirements.txt \
    && pip install --no-cache-dir -r seira_web/requirements-hermes.txt

# The constitutional core, the bridge, the web app, and the founding
# texts — unchanged from before. seira_founding/ (not docs/, and .txt
# not .md) is deliberate: the fork's own .dockerignore excludes both
# "docs/" and "*.md" wholesale for Hermes's doc site, which would
# silently strip these otherwise. (.dockerignore does NOT exclude the
# agent/tools/hermes_cli/plugins/cron paths added below — verified;
# it only strips docs/ subfolders nested inside them, e.g.
# plugins/hermes-achievements/docs/, which the runtime doesn't read.)
COPY seira_core/ seira_core/
COPY seira_bridge/ seira_bridge/
COPY seira_web/ seira_web/
COPY seira_founding/ seira_founding/
COPY LICENSE NOTICE ./

# The real Hermes agent runtime — added so she operates atop it, in all,
# rather than beside a reimplementation of it. Tested import list; see
# the block comment above before adding or removing a path here.
COPY agent/ agent/
COPY tools/ tools/
COPY hermes_cli/ hermes_cli/
COPY plugins/ plugins/
COPY cron/ cron/
COPY run_agent.py hermes_bootstrap.py hermes_constants.py toolsets.py \
     model_tools.py utils.py hermes_logging.py hermes_time.py \
     hermes_state.py ./

# State lives on the mounted volume, never in the image:
#   SEIRA_TENANTS_ROOT=/data/tenants  SEIRA_PLATFORM_ROOT=/data/platform
EXPOSE 8000
CMD ["python", "-m", "seira_web"]
